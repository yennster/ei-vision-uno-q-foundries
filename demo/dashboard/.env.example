# Booth dashboard — laptop-only secrets.
# Copy to `.env` and fill in. Never commit `.env`.

# Edge Impulse — read scope only is enough
EI_API_KEY=ei_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EI_PROJECT_ID=25483

# Foundries.io — read scope on devices/targets
FOUNDRIES_API_TOKEN=
FOUNDRIES_FACTORY=jenny

# GitHub repo to read workflow runs/tags from.
# GH_TOKEN is optional but recommended (60/hr → 5000/hr rate limit).
GH_REPO=yennster/ei-vision-uno-q-foundries
GH_TOKEN=

# URL of the running edge-impulse-linux-runner web UI.
# Iframed in the "Live inference" pane. Leave blank to hide that pane.
# Examples:
#   http://uno-q.local:4912
#   http://192.168.1.42:4912
RUNNER_URL=

# Optional — backend polling interval in seconds (default 20)
POLL_INTERVAL=20
